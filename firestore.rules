rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function shortName(value) { return value is string && value.size() > 0 && value.size() <= 100; }
    // Console-created numeric fields may use doubles even for whole numbers.
    // Validate exact, non-negative sen without requiring an integer encoding.
    function wholeSen(value) {
      return value is number && value >= 0 && value <= 9007199254740991
        && value == int(value);
    }

    function invitationEvent(eventId) {
      return eventId in ['faiz-harissa', 'faiz-harissa-groom'];
    }

    match /weddings/{eventId}/rsvps/{uid} {
      allow get: if invitationEvent(eventId) && owner(uid);
      allow create, update: if invitationEvent(eventId) && owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'attendance', 'guests', 'updatedAt'])
        && shortName(request.resource.data.name)
        && request.resource.data.attendance in ['Hadir, insya-Allah', 'Maaf, tidak dapat hadir']
        && request.resource.data.guests is int
        && ((request.resource.data.attendance == 'Hadir, insya-Allah'
          && request.resource.data.guests >= 1 && request.resource.data.guests <= 5)
          || (request.resource.data.attendance == 'Maaf, tidak dapat hadir' && request.resource.data.guests == 0))
        && request.resource.data.updatedAt == request.time;
    }

    match /weddings/{eventId}/wishes/{uid} {
      allow read: if invitationEvent(eventId) && signedIn();
      allow create, update: if invitationEvent(eventId) && owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'message', 'updatedAt'])
        && shortName(request.resource.data.name)
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if invitationEvent(eventId) && owner(uid);
    }

    match /weddings/faiz-harissa/gifts/{id} {
      allow read: if signedIn();
      function validGift() {
        let value = request.resource.data;
        return value.keys().hasOnly(['name', 'claimedBy', 'updatedAt'])
          && shortName(value.name) && value.claimedBy is string
          && value.updatedAt == request.time;
      }
      function configuredName() {
        return (id == 'air-fryer' && request.resource.data.name == 'Air fryer')
          || (id == 'dinnerware' && request.resource.data.name == 'Set pinggan mangkuk')
          || (id == 'vacuum' && request.resource.data.name == 'Penyedut hampagas')
          || (id == 'bedding' && request.resource.data.name == 'Set cadar king')
          || id.matches('custom-[a-zA-Z0-9-]{36}');
      }
      allow create: if signedIn() && id != 'coffee' && validGift() && configuredName()
        && request.resource.data.claimedBy == request.auth.uid;
      allow update: if signedIn() && id != 'coffee' && validGift()
        && request.resource.data.name == resource.data.name
        && ((resource.data.claimedBy == '' && request.resource.data.claimedBy == request.auth.uid)
          || (resource.data.claimedBy == request.auth.uid && request.resource.data.claimedBy == ''));

      function validContributionTotal() {
        let value = request.resource.data;
        let path = /databases/$(database)/documents/weddings/faiz-harissa/contributions/$(value.lastContribution);
        let contribution = getAfter(path).data;
        let previous = exists(/databases/$(database)/documents/weddings/faiz-harissa/gifts/coffee)
          ? get(/databases/$(database)/documents/weddings/faiz-harissa/gifts/coffee).data.contributedCents : 0;
        return value.keys().hasOnly(['name', 'contributedCents', 'lastContribution'])
          && value.name == 'Mesin kopi'
          && value.contributedCents is int && value.contributedCents <= 300000
          && !exists(path) && contribution.uid == request.auth.uid
          && value.contributedCents == previous + contribution.amountCents;
      }
      allow create, update: if signedIn() && id == 'coffee' && validContributionTotal();
    }

    // New shared-gift funds keep their totals separate from whole-gift claims.
    match /weddings/faiz-harissa/gift-funds/{giftId} {
      allow read: if signedIn();
      function validFundTotal() {
        let value = request.resource.data;
        let receiptPath = /databases/$(database)/documents/weddings/faiz-harissa/contributions/$(value.lastContributionId);
        let receipt = getAfter(receiptPath).data;
        let previous = resource.data.contributedCents;
        return giftId.matches('[a-z0-9]+(-[a-z0-9]+)*') && giftId.size() <= 100
          && value.keys().hasOnly(['targetCents', 'contributedCents', 'lastContributionId'])
          && wholeSen(resource.data.targetCents) && resource.data.targetCents > 0
          && value.targetCents == resource.data.targetCents
          && wholeSen(previous)
          && wholeSen(value.contributedCents) && value.contributedCents > 0
          && value.contributedCents <= resource.data.targetCents
          && !exists(receiptPath) && receipt.uid == request.auth.uid
          && receipt.giftId == giftId && receipt.reference == 'wedding-' + giftId
          && value.contributedCents == previous + receipt.amountCents;
      }
      // The owner configures the price through the console/Admin SDK. Guests
      // cannot create funds or increase the target to bypass the cap.
      allow update: if signedIn() && validFundTotal();
    }

    match /weddings/faiz-harissa/contributions/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/weddings/faiz-harissa/contributions/$(id))
        || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'amountCents', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0 && request.resource.data.amountCents <= 300000
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/weddings/faiz-harissa/gifts/coffee).data.lastContribution == id;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'giftId', 'reference', 'amountCents', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.giftId is string
        && request.resource.data.giftId.matches('[a-z0-9]+(-[a-z0-9]+)*')
        && request.resource.data.giftId.size() <= 100
        && request.resource.data.reference == 'wedding-' + request.resource.data.giftId
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0 && request.resource.data.amountCents <= 100000000
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/weddings/faiz-harissa/gift-funds/$(request.resource.data.giftId)).data.lastContributionId == id;
    }

    // Wedding memories live separately from invitation RSVPs and gifts.
    function memoryEvent(eventId) { return eventId in ['faiz-harissa', 'faiz-harissa-groom']; }
    function coupleOwner() { return signedIn() && request.auth.token.owner == true; }
    function validSlot(slot) { return slot is int && slot >= 1 && slot <= 20; }
    function validUploadKey(key) { return key is string && key.matches('[a-zA-Z0-9-]{36}'); }
    function boundedMemoryName(value) { return value is string && value.size() > 0 && value.size() <= 100; }
    function validPhotoStyle(data) {
      return !('photoStyle' in data) || (
        data.photoStyle is map
        && data.photoStyle.keys().hasOnly(['film', 'stamp', 'capturedAt'])
        && data.photoStyle.keys().hasAll(['film', 'stamp', 'capturedAt'])
        && data.photoStyle.film in ['none', 'classic-chrome', 'classic-neg', 'nostalgic-neg', 'acros', 'warm', 'soft']
        && data.photoStyle.stamp is string && data.photoStyle.stamp.size() <= 100
        && data.photoStyle.capturedAt is int && data.photoStyle.capturedAt > 0
        && data.photoStyle.capturedAt <= request.time.toMillis() + 86400000
      );
    }
    match /weddings/{eventId}/memoryAlbums/main/public/{settingId} {
      allow read: if memoryEvent(eventId) && settingId == 'settings';
      allow create, update: if memoryEvent(eventId) && settingId == 'settings' && coupleOwner()
        && request.resource.data.keys().hasOnly(['welcome', 'cover', 'film', 'stamp', 'bankRecipient', 'bankDetails', 'qrUrl', 'updatedAt'])
        && request.resource.data.welcome is string && request.resource.data.welcome.size() <= 1000
        && request.resource.data.cover is string && request.resource.data.cover.size() <= 2048
        && request.resource.data.film in ['none', 'classic-chrome', 'classic-neg', 'nostalgic-neg', 'acros', 'warm', 'soft']
        && request.resource.data.stamp is string && request.resource.data.stamp.size() <= 100
        && request.resource.data.bankRecipient is string && request.resource.data.bankRecipient.size() <= 100
        && request.resource.data.bankDetails is string && request.resource.data.bankDetails.size() <= 300
        && request.resource.data.qrUrl is string && request.resource.data.qrUrl.size() <= 2048
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /weddings/{eventId}/memoryAlbums/main/reservations/{reservationId} {
      allow get: if memoryEvent(eventId) && signedIn()
        && reservationId.matches(request.auth.uid + '_([1-9]|1[0-9]|20)')
        && (!exists(/databases/$(database)/documents/weddings/$(eventId)/memoryAlbums/main/reservations/$(reservationId))
          || resource.data.uid == request.auth.uid);
      allow list: if memoryEvent(eventId) && signedIn() && resource.data.uid == request.auth.uid;
      allow create: if memoryEvent(eventId) && signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'slot', 'guestName', 'uploadKey', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && validSlot(request.resource.data.slot)
        && reservationId == request.auth.uid + '_' + string(request.resource.data.slot)
        && validUploadKey(request.resource.data.uploadKey)
        && boundedMemoryName(request.resource.data.guestName) && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /weddings/{eventId}/memoryAlbums/main/photos/{photoId} {
      function reservedPhoto() {
        let slot = request.resource.data.slot;
        let reservation = get(/databases/$(database)/documents/weddings/$(eventId)/memoryAlbums/main/reservations/$(request.auth.uid + '_' + string(slot))).data;
        return validSlot(slot) && validUploadKey(request.resource.data.uploadKey)
          && photoId == request.auth.uid + '_' + string(slot)
          && reservation.uid == request.auth.uid && reservation.slot == slot
          && reservation.guestName == request.resource.data.guestName
          && reservation.uploadKey == request.resource.data.uploadKey;
      }
      allow get: if memoryEvent(eventId) && ((signedIn() && photoId.matches(request.auth.uid + '_([1-9]|1[0-9]|20)')
          && !exists(/databases/$(database)/documents/weddings/$(eventId)/memoryAlbums/main/photos/$(photoId)))
        || resource.data.status == 'complete' || coupleOwner());
      allow list: if memoryEvent(eventId) && (resource.data.status == 'complete' || coupleOwner());
      allow create: if memoryEvent(eventId) && signedIn() && reservedPhoto()
        && request.resource.data.keys().hasOnly(['uid', 'slot', 'guestName', 'uploadKey', 'originalPath', 'contentType', 'size', 'createdAt', 'status', 'photoStyle'])
        && validPhotoStyle(request.resource.data)
        && request.resource.data.uid == request.auth.uid && boundedMemoryName(request.resource.data.guestName)
        && request.resource.data.originalPath == 'weddings/' + eventId + '/memoryAlbums/main/photos/' + request.auth.uid + '/' + string(request.resource.data.slot) + '/original'
        && request.resource.data.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 12582912
        && request.resource.data.createdAt == request.time && request.resource.data.status == 'complete';
      allow update, delete: if false;
    }
    match /weddings/{eventId}/memoryAlbums/main/photos/{photoId}/favorites/{uid} {
      allow get, list: if memoryEvent(eventId) && (owner(uid) || coupleOwner());
      allow create: if memoryEvent(eventId) && owner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time;
      allow delete: if memoryEvent(eventId) && owner(uid);
      allow update: if false;
    }
    match /weddings/{eventId}/memoryAlbums/main/wishes/{wishId} {
      allow read: if memoryEvent(eventId);
      allow create: if memoryEvent(eventId) && signedIn()
        && wishId.matches(request.auth.uid + '_[0-9]{13}')
        && request.resource.data.keys().hasOnly(['uid', 'guestName', 'message', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && boundedMemoryName(request.resource.data.guestName)
        && request.resource.data.message is string && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000 && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /weddings/{eventId}/memoryAlbums/main/voicePublic/{voiceId} {
      allow get: if memoryEvent(eventId) && (resource.data.status == 'complete' || coupleOwner()
        || (signedIn() && voiceId.matches(request.auth.uid + '_[a-zA-Z0-9-]{36}')
          && (!exists(/databases/$(database)/documents/weddings/$(eventId)/memoryAlbums/main/voicePublic/$(voiceId))
            || resource.data.uid == request.auth.uid)));
      allow list: if memoryEvent(eventId) && (resource.data.status == 'complete' || coupleOwner());
      allow create: if memoryEvent(eventId) && signedIn()
        && voiceId.matches(request.auth.uid + '_[a-zA-Z0-9-]{36}')
        && request.resource.data.keys().hasOnly(['uid', 'guestName', 'uploadKey', 'path', 'contentType', 'createdAt', 'status'])
        && request.resource.data.uid == request.auth.uid && boundedMemoryName(request.resource.data.guestName)
        && request.resource.data.path == 'weddings/' + eventId + '/memoryAlbums/main/publicAudio/' + voiceId
        && validUploadKey(request.resource.data.uploadKey)
        && voiceId == request.auth.uid + '_' + request.resource.data.uploadKey
        && request.resource.data.contentType.matches('audio/(webm|mp4|ogg|3gpp).*')
        && request.resource.data.createdAt == request.time && request.resource.data.status == 'pending';
      allow update: if memoryEvent(eventId) && signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'downloadUrl'])
        && request.resource.data.status == 'complete'
        && request.resource.data.path == resource.data.path && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }
    match /weddings/{eventId}/memoryAlbums/main/voicePrivate/{voiceId} {
      allow get: if memoryEvent(eventId) && (coupleOwner()
        || (signedIn() && voiceId.matches(request.auth.uid + '_[a-zA-Z0-9-]{36}')
          && (!exists(/databases/$(database)/documents/weddings/$(eventId)/memoryAlbums/main/voicePrivate/$(voiceId))
            || resource.data.uid == request.auth.uid)));
      allow list: if memoryEvent(eventId) && coupleOwner();
      allow create: if memoryEvent(eventId) && signedIn()
        && voiceId.matches(request.auth.uid + '_[a-zA-Z0-9-]{36}')
        && request.resource.data.keys().hasOnly(['uid', 'guestName', 'uploadKey', 'path', 'contentType', 'createdAt', 'status'])
        && request.resource.data.uid == request.auth.uid && boundedMemoryName(request.resource.data.guestName)
        && request.resource.data.path == 'weddings/' + eventId + '/memoryAlbums/main/privateAudio/' + voiceId
        && validUploadKey(request.resource.data.uploadKey)
        && voiceId == request.auth.uid + '_' + request.resource.data.uploadKey
        && request.resource.data.contentType.matches('audio/(webm|mp4|ogg|3gpp).*')
        && request.resource.data.createdAt == request.time && request.resource.data.status == 'pending';
      allow update: if memoryEvent(eventId) && signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'complete' && request.resource.data.path == resource.data.path
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }
  }
}
